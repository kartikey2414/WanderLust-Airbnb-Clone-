<% layout("/layouts/boilerplate") %>

<div class="row mt-3 justify-content-center">
  <div class="col-12 col-md-8">
    <h3 class="fw-bold mb-3">Create New Listing</h3>
    <form method="post" action="/listings" novalidate class="needs-validation" enctype="multipart/form-data">
      
      <div class="mb-3">
        <label for="title" class="form-label fw-semibold">Title</label>
        <input
          type="text"
          placeholder="Add a catchy title"
          name="listing[title]"
          class="form-control"
          required
        />
        <div class="valid-feedback">Title looks good!</div>
        <div class="invalid-feedback">Please provide a title</div>
      </div>

      <div class="mb-3">
        <label for="description" class="form-label fw-semibold">Description</label>
        <textarea class="form-control" name="listing[description]" rows="4" required></textarea>
        <div class="invalid-feedback">Please enter a short Description</div>
      </div>

      <div class="mb-3">
        <label for="image" class="form-label fw-semibold">Upload Listing Image</label>
        <input
          name="listing[image]"
          type="file"
          class="form-control"
          required
        />
      </div>

      <div class="row">
        <div class="mb-3 col-12 col-md-4">
          <label for="price" class="form-label fw-semibold">Price</label>
          <input
            type="number"
            placeholder="1200"
            name="listing[price]"
            class="form-control"
            required
          />
          <div class="invalid-feedback">Price should be valid</div>
        </div>
        <div class="mb-3 col-12 col-md-8">
          <label for="country" class="form-label fw-semibold">Country</label>
          <input
            type="text"
            placeholder="India"
            name="listing[country]"
            class="form-control"
            required
          />
          <div class="invalid-feedback">Country should be valid</div>
        </div>
      </div>

      <div class="mb-3">
        <label for="location" class="form-label fw-semibold">Location</label>
        <input
          type="text"
          placeholder="Uttar-Pradesh, Hardoi"
          name="listing[location]"
          class="form-control"
          required
        />
        <div class="invalid-feedback">Location should be valid</div>
      </div>

      <button class="btn btn-dark add-btn px-4 py-2 mb-4">Add Listing</button>
    </form>
  </div>
</div>